# Compose constructs a database URL from this value, so use letters and digits.
POSTGRES_PASSWORD=ReplaceWithLocalPassword123
DATABASE_URL=postgresql://nova:ReplaceWithLocalPassword123@localhost:5432/nova
TEST_DATABASE_URL=postgresql://nova:ReplaceWithLocalPassword123@localhost:5432/nova_test
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NOVA_ALLOW_DEMO_SEED=false
DEMO_PASSWORD=
