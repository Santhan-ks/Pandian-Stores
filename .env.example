# Compose constructs a database URL from this value, so use letters and digits.
POSTGRES_PASSWORD=ReplaceWithLocalPassword123
DATABASE_URL=postgresql://nova:ReplaceWithLocalPassword123@localhost:5432/nova
TEST_DATABASE_URL=postgresql://nova:ReplaceWithLocalPassword123@localhost:5432/nova_test
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional alternate loopback ports. Keep database URLs and browser origin in sync.
NOVA_DB_PORT=5432
NOVA_APP_PORT=3000
# Set this to the same browser origin when using an alternate app port.
# SMOKE_BASE_URL=http://localhost:3000
NOVA_ALLOW_DEMO_SEED=false
DEMO_PASSWORD=

# Explicitly opt in only for exercise/demo invoices.
NOVA_ALLOW_DEMO_INVOICES=false
